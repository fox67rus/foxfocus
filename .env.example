# Имя приложения в заголовке API и Swagger
APP_NAME=Foxfocus

# Единственная точка настройки БД. Относительный путь считается от корня репозитория,
# файл SQLite лежит в data/ и не попадает в git.
DATABASE_URL=sqlite+aiosqlite:///./data/foxfocus.db

# Сколько миллисекунд ждать снятия блокировки SQLite (PRAGMA busy_timeout)
SQLITE_BUSY_TIMEOUT_MS=5000

# Режим разбора текста. mock — без сети. live — ProxyAPI или официальный OpenAI.
LLM_MODE=mock

# Если PROXYAPI_KEY задан и не placeholder — берётся он и https://api.proxyapi.ru/openai/v1
PROXYAPI_KEY=

# Иначе официальный ключ из окружения: OPENAI_API_KEY или OPENAI_KEY
OPENAI_API_KEY=
# OPENAI_KEY=

# Необязательно: свой base URL перекрывает дефолт выбранного провайдера
# OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

OPENAI_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1

# Каталог собранной панели. В контейнере задаётся сам. Локально после npm run build — frontend/dist.
# STATIC_DIR=
